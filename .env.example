# =============================================================================
# Horus deployment configuration - copy to .env (chmod 600) and fill in.
# Values here are placeholders only. Secrets left EMPTY are generated on first start by `horus-init` and stored in
# the horus_secrets Docker volume (never in this file). Generate your own values with:  openssl rand -hex 32
# =============================================================================

# --- Images ------------------------------------------------------------------------------------------------
# One private Docker Hub repository: <dockerhub_username>/horus with the tags backend-<version> / frontend-<version>
# (both linux/amd64 + linux/arm64). Use an exact release version - never "latest".
HORUS_IMAGE=docker.io/doganyesilkir/horus
HORUS_VERSION=1.0.0-rc.12
# Optional digest pinning (sha256:... from release-manifest.json); verify-signatures.sh requires them
HORUS_BACKEND_DIGEST=sha256:2d3db2127146d5daa87d9d65e77490bc1ab81f51bbaeacfac7908ec1ef947b93
HORUS_FRONTEND_DIGEST=sha256:3ac2513441ae2a9f88a411d255c278169e6b1ed3273cd4168255af2d55aa2118

# --- Access ------------------------------------------------------------------------------------------------
# DNS name users open (used for the self-signed certificate and in the README checks)
HORUS_DOMAIN=
# https (production, default) | http-dev (development / isolated lab only - no TLS)
HORUS_PROXY_MODE=https
HORUS_BIND_ADDRESS=0.0.0.0
HORUS_HTTPS_PORT=443
HORUS_HTTP_PORT=80
# auto: auth cookies are Secure when the request arrived over HTTPS
HORUS_COOKIE_SECURE=auto

# --- Bootstrap administrator (created only when no user exists; must be changed at first login) -------------
HORUS_ADMIN_USERNAME=admin
HORUS_ADMIN_EMAIL=
# REQUIRED for a new installation: strong and unique (weak / example values are refused at start)
HORUS_ADMIN_PASSWORD=

# --- Secrets (empty = generated once into the horus_secrets volume) --------------------------------------------
# Master key encrypting stored SSH keys and integration secrets. LOSING IT MAKES THEM UNRECOVERABLE - back up the
# volume (scripts/backup.sh) or manage the value yourself.
HORUS_MASTER_KEY=
HORUS_JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
HORUS_INGEST_TOKEN=

# --- Automation safety ----------------------------------------------------------------------------------------
# OBSERVE | APPROVAL | AUTONOMOUS (initial value; changeable in Settings)
HORUS_OPERATION_MODE=APPROVAL
# true: the requester may approve their own job (single-admin installations); false: four-eyes principle
HORUS_ALLOW_SELF_APPROVAL=true
HORUS_PRODUCTION_REQUIRED_APPROVALS=2
HORUS_JOB_TIMEOUT_SECONDS=1800
HORUS_WORKER_CONCURRENCY=4
# must not exceed the host's CPU count
HORUS_WORKER_CPUS=2.0
# IPs/CIDRs playbooks must never block (comma separated)
HORUS_IP_WHITELIST=127.0.0.1/32
HORUS_FORWARDED_ALLOW_IPS=
HORUS_SCHEDULE_TIMEZONE=UTC
HORUS_SERVICE_STATUS_INTERVAL_SECONDS=60
# Domain monitoring: checks running at the same time per worker run, and days raw check results are kept
# (hourly / daily uptime summaries are kept longer). Internal targets: Domain Monitoring -> Internal targets.
HORUS_MONITOR_CONCURRENCY=8
HORUS_MONITOR_RETENTION_DAYS=90
HORUS_FIREWALL_ROLLBACK_TIMEOUT=120

# --- UI / password policy ------------------------------------------------------------------------------------
HORUS_DEFAULT_LANGUAGE=tr
HORUS_PASSWORD_MIN_LENGTH=12
HORUS_PASSWORD_REQUIRE_UPPER=true
HORUS_PASSWORD_REQUIRE_LOWER=true
HORUS_PASSWORD_REQUIRE_DIGIT=true
HORUS_PASSWORD_REQUIRE_SPECIAL=true
HORUS_PASSWORD_CHANGE_MAX_ATTEMPTS=5

# --- Runtime security (Falco) --------------------------------------------------------------------------------
# URL managed servers use to send Falco events to Horus, e.g. https://horus.example.com
HORUS_FALCO_INGEST_URL=
HORUS_FALCO_HOSTNAME=horus-docker-host

# --- Wazuh ------------------------------------------------------------------------------------------------------
# External Wazuh with docker-compose.yml: set HORUS_WAZUH_ENABLED=true and the URLs / passwords below.
# Bundled Wazuh (docker-compose.wazuh.yml) enables the integration itself.
HORUS_WAZUH_ENABLED=false
HORUS_WAZUH_API_URL=
HORUS_WAZUH_API_USER=wazuh-wui
HORUS_WAZUH_API_PASSWORD=
HORUS_WAZUH_INDEXER_URL=
HORUS_WAZUH_INDEXER_USER=admin
HORUS_WAZUH_INDEXER_PASSWORD=
HORUS_WAZUH_VERIFY_TLS=true
HORUS_WAZUH_CA_BUNDLE=
# Bundled Wazuh 4.14.8 (linux/amd64 and linux/arm64) only - REQUIRED by docker-compose.wazuh.yml (no published
# default is ever used). Install with ./scripts/install.sh --with-wazuh: it adds COMPOSE_FILE=docker-compose.wazuh.yml
# to this file, so docker compose and every script include the Wazuh services from then on.
# Wazuh API password rules: 8-64 characters with upper case, lower case, digit and symbol.
WAZUH_INDEXER_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_DASHBOARD_BIND=127.0.0.1
WAZUH_DASHBOARD_PORT=8443
# Indexer (OpenSearch) heap; empty = -Xms1g -Xmx1g. About half of the memory you give the indexer.
WAZUH_INDEXER_JAVA_OPTS=

# --- Secret backend --------------------------------------------------------------------------------------------
# database (default: SSH keys encrypted in PostgreSQL) | vault (HashiCorp Vault KV v2)
HORUS_SECRET_BACKEND=database
HORUS_VAULT_ADDR=
# path INSIDE the containers of a mounted token file (never put the token itself in this file)
HORUS_VAULT_TOKEN_FILE=
HORUS_VAULT_MOUNT=secret
HORUS_VAULT_PREFIX=horus
HORUS_VAULT_NAMESPACE=
HORUS_VAULT_VERIFY_TLS=true

# --- Image signatures (scripts/verify-signatures.sh; value from release-manifest.json) --------------------
HORUS_SIGNING_IDENTITY=^https://github\.com/doganyesilkir/Horus/\.github/workflows/release\.yml@refs/tags/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$
