# Loaded only by docker-compose.full.yml: enables the Wazuh integration and
# points Horus at the bundled single-node Wazuh. Values in .env
# (HORUS_WAZUH_API_PASSWORD / HORUS_WAZUH_INDEXER_PASSWORD) take precedence.
HORUS_WAZUH_ENABLED_FULL=true
HORUS_WAZUH_API_URL_FULL=https://wazuh.manager:55000
HORUS_WAZUH_INDEXER_URL_FULL=https://wazuh.indexer:9200
# Wazuh passwords are NOT defaulted here (HR-091): set WAZUH_INDEXER_PASSWORD, WAZUH_API_PASSWORD and
# WAZUH_DASHBOARD_PASSWORD in .env - docker-compose.full.yml refuses to start without them (docs/wazuh.md).
